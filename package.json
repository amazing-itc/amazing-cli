{
  "name": "amazing-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --test --test-timeout=30000 \"src/**/__TESTS__/**/*.test.ts\"",
    "e2e:fake": "bash scripts/e2e-fake.sh",
    "e2e:cursor": "bash scripts/e2e-cursor-session.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run build && node scripts/check-boundaries.mjs && node scripts/check-openapi.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "yaml": "^2.9.1"
  }
}

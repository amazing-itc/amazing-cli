# Local defaults. `cp .env.example .env` boots as-is.
# Change values only if you want different secrets. Do not commit .env.
# --- amazing-cli (service auth + queue) ---
# One service secret. Any caller that sends this Bearer is served the same way.
# The caller names itself with X-Amazing-Product. This file does not list products.
# Key ≥16 characters. The same value goes in the caller's own env.
AMAZING_CLI_API_KEY=local-dev-amazing-cli-key-0123456789
AMAZING_CLI_MAX_CONCURRENT_RUNS=4
AMAZING_CLI_MAX_CONCURRENT_RUNS_PER_PRODUCT=2

# Optional parent jail for relative workspace.path only (`/data/products/<id>`).
# Absolute workspace.path is used as-is — no product root required.
# AMAZING_CLI_WORKSPACE_ROOTS=alpha=/mnt/alpha

# Optional host tree bind-mounted at /data/products (default ./workspaces in this repo).
# WORKSPACES_HOST_DIR=./workspaces

# Optional extra provider manifests. A duplicate family or invalid file fails boot.
# AMAZING_CLI_PROVIDERS_DIR=/data/amazing-cli/providers

# --- LiteLLM (only amazing-cli reaches this; products must not join network amazing-llm) ---
LITELLM_MASTER_KEY=sk-change-me-litellm-master
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=change-me-litellm-db
LITELLM_DB_NAME=litellm
UI_USERNAME=admin
UI_PASSWORD=change-me-litellm-ui
# Optional. External models only. Leave empty to boot without them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
